DATABASE_URL=postgres://solatel:solatel@localhost:5432/solatel
BIND_ADDR=0.0.0.0:8080
RUST_LOG=solatel_server=debug,tower_http=debug,info

# There is no SOLATEL_MAP any more. The server runs every map it has, several
# matches at once on different ground, and which one a player ends up on is
# the table they pick in the menu.

# Everything below is about money, and every one of these is off by default.
# A server started with none of them set charges a real entry fee for every
# life and pays it to whoever takes that life.

# Hand every new player this many whole dollars, once, the first time they are
# seen. Development only: there is no deposit flow yet, so without it nobody
# can afford to spawn - which is correct behaviour and an unplayable game. It
# posts a real deposit against the `external` account, so the books still
# balance and the grant shows up as exactly what it is.
# SOLATEL_DEV_GRANT=20

# Which tables this server offers, comma separated, out of 1, 2, 5 and 10. The
# rake is ten percent at every one, so the $5 table pays $4.50 a kill and keeps
# $0.50. All four by default: one process holds every match at every stake,
# which is what keeps the escrow sweep honest.
# SOLATEL_TIERS=1,2,5,10

# A match starts as soon as the table fills - 20 on the arena, 30 on the yard
# - and otherwise waits this many seconds and then starts with whoever is
# there, as long as there are at least SOLATEL_MATCH_FLOOR of them. A line
# still under the floor keeps waiting.
# SOLATEL_QUEUE_WAIT=120

# Fewest players a match will start with once that window is up. Four by
# default; below that a match is one or two people on a map built for twenty
# or thirty. Set it to 1 to test the game by yourself.
# SOLATEL_MATCH_FLOOR=4

# Entry costs nothing and kills pay nothing. For working on movement and
# shooting without a wallet in the way. Never set this anywhere real.
# SOLATEL_FREE_PLAY=1

# ---- the wallet: deposits and withdrawals, on Solana devnet ---------------
# Both of these or neither. With neither, the wallet is off and the menu says
# so; with only one, the server refuses to start.
#
# The treasury's secret key, base58. `./x treasury` makes one and prints it.
# SOLATEL_TREASURY_KEY=
#
# What one SOL is worth, in dollars. Fixed: nothing reads a market. On devnet
# the SOL is free and this only has to be deterministic; on a real network it
# would mean eating the difference from the real price on every deposit and
# withdrawal. There is no default, on purpose.
# SOLATEL_SOL_USD=140
#
# A second devnet key that `./x pay <memo> <sol>` sends test deposits from,
# because most wallets cannot attach a memo. `./x pay` with no arguments
# makes one.
# SOLATEL_DEV_PAYER_KEY=
#
# Withdrawals are refused while SOLATEL_DEV_GRANT is set: development money
# can be played with and must not leave as SOL.
