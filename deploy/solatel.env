# The server's settings on the VPS (deploy/install.sh). They are copied into
# each release, so changing one is a commit that goes live like any other
# change. Nothing secret is here or may be: the database is reached through
# Postgres's socket as the system user `solatel`, with no password, and the
# admin token is in /etc/solatel/secret.env, made on the server. A file
# /etc/solatel/local.env, if somebody writes one there, overrides this one on
# that machine alone.
DATABASE_URL=postgres://solatel@localhost/solatel?host=/var/run/postgresql
BIND_ADDR=127.0.0.1:8080
WEB_DIR=/opt/solatel/current/web
RUST_LOG=solatel_server=info,tower_http=warn,info

# ---- the test month ----------------------------------------------------------
# Every one of these goes before real money (documents/RUNBOOK.md).
#
# Test money: each new player is given $100 once. It cannot leave - there is
# no wallet to deposit into or withdraw from, and withdrawals are refused
# while this is set - and the menu says it is development money.
SOLATEL_DEV_GRANT=100
# The $1 table only, so a handful of testers end up in one line per map
# rather than spread over twelve.
SOLATEL_TIERS=1
# A match starts 45 seconds after the first person joins its line, with
# whoever is there - even one, so nobody testing alone waits for ever.
SOLATEL_MATCH_FLOOR=1
SOLATEL_QUEUE_WAIT=45
